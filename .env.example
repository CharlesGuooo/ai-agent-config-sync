# API keys for MCP servers — fill in and rename to .env
# Never commit the .env file (it's gitignored).

# GitHub MCP — github-mcp-server requires a personal access token
GITHUB_PERSONAL_ACCESS_TOKEN=

# Z.AI MCP — web-reader + zai-mcp-server
Z_AI_API_KEY=

# Supabase MCP (opt-in)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Expo MCP (opt-in)
EXPO_TOKEN=

# Brave Search MCP
BRAVE_API_KEY=
